\title{
Nonlocal realism tests and quantum state tomography in Sagnac-based type-II polarization-entanglement SPDC-source
}

\author{
Ali Motazedifard, \({ }^{1,2,3, *}\) S. A. Madani, \({ }^{1,2}\) J. J. Dashkasan, \({ }^{1}\) and N. S. Vayaghan \({ }^{1,2}\) \\ \({ }^{1}\) Quantum Optics Group, Iranian Center for Quantum Technologies (ICQTs), Tehran, Iran \\ \({ }^{2}\) Quantum Communication Group, Iranian Center for Quantum Technologies (ICQTs), Tehran, Iran \\ \({ }^{3}\) Quantum Sensing and Metrology Group, Iranian Center for Quantum Technologies (ICQTs), Tehran, Iran
